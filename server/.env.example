# =============================================================================
# BloodLink AI — Server Environment Configuration Template
# =============================================================================
# Copy to server/.env for local server development.
# For Cloud Deployments (Render / Railway / Fly.io / VPS / Vercel Serverless):
# Configure these variables in your host's Environment Variables dashboard.

# Server listening port (set by host in cloud environments)
PORT=5002

# Persistent Cloud MongoDB Connection (MongoDB Atlas):
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/smart-blood-bank

# Secure JWT signing secret (MUST be at least 32 characters in production)
JWT_SECRET=your_super_secret_jwt_key_must_be_at_least_32_characters_long

# CORS Allowed Origins (Comma-separated)
# Add your production frontend URL (e.g. https://bloodlink-ai.vercel.app)
CLIENT_URL=http://localhost:5173,https://your-bloodlink-app.vercel.app

# Environment
NODE_ENV=production

# Campus Configuration
CAMPUS_NAME=JC Bose University of Science and Technology, YMCA
CAMPUS_ADDRESS=Sector 6, Mathura Road, Faridabad, Haryana 121006
CAMPUS_LATITUDE=28.3676
CAMPUS_LONGITUDE=77.3159
