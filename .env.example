# =============================================================================
# BloodLink AI — Production & Local Environment Configuration Template
# =============================================================================
# Copy this file to .env for local development.
# For Vercel / Cloud deployments, add these key names in your project settings.
# NEVER commit your actual .env file or real secrets to GitHub!

# Backend Port (Defaults to 5002 locally; provided automatically by cloud hosts)
PORT=5002

# MongoDB Connection String:
# - For Local Development:
#   MONGO_URI=mongodb://localhost:27017/smart-blood-bank
#   (If local MongoDB is not running, dev mode automatically uses in-memory MongoDB)
# - For Production (REQUIRED: MongoDB Atlas):
#   MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smart-blood-bank?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/smart-blood-bank

# JWT Authentication Secret (MUST be at least 32 characters in production)
JWT_SECRET=your_super_secret_jwt_key_must_be_at_least_32_characters_long

# Allowed Frontend Origins for CORS:
# Comma-separated list of allowed origins.
# In local dev: http://localhost:5173
# In production: https://your-bloodlink-app.vercel.app
# Note: Any *.vercel.app domain is automatically accepted by the backend.
CLIENT_URL=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Runtime environment (development | production)
NODE_ENV=development

# Campus Identification & Localization (Optional - Defaults to JC Bose UST YMCA Faridabad)
CAMPUS_NAME=JC Bose University of Science and Technology, YMCA
CAMPUS_ADDRESS=Sector 6, Mathura Road, Faridabad, Haryana 121006
CAMPUS_LATITUDE=28.3676
CAMPUS_LONGITUDE=77.3159
